[sub_resource type="GDScript" id="GDScript_3uq8f"]
script/source = "extends CharacterBody2D

@export var max_speed: float = 300.0
@export var acceleration: float = 150.0
@export var friction: float = 200.0
@export var boost_speed_multiplier: float = 3.0
@export var boost_drain_rate: float = 1.0
@export var boost_recharge_rate: float = 0.20
@export var turn_speed: float = 2.5

# Health
@export var max_health: float = 100.0
@export var collision_damage: float = 5.0
@export var damage_cooldown: float = 0.5
var health: float = 100.0
var damage_timer: float = 0.0

# Repair cooldown
@export var repair_cooldown: float = 7.5
var repair_cooldown_timer: float = 0.0

var boost_charge: float = 1.0
var is_boosting: bool = false
var boost_locked: bool = false

@export var pulse_speed: float = 3.0
var pulse_time: float = 0.0

@onready var boost_bar = $CanvasLayer/Boostbar
@onready var health_bar = $CanvasLayer2/Health
@onready var warning: Label = $Warning
@onready var repair_ui = $CanvasLayer2/RepairUI

func _ready() -> void:
	var dark = get_node(\"/root/Main/Dark\")
	dark.color = Color(0.03, 0.08, 0.40, 1.0)
	$PointLight2D.texture_scale = 2.0
	$PointLight2D.color = Color(0.85, 0.95, 1.0)
	$PointLight2D.energy = 1.2
	$PointLight2D.blend_mode = PointLight2D.BLEND_MODE_ADD
	$CPUParticles2D.emitting = true
	$CPUParticles2D.amount = 8
	$CPUParticles2D.lifetime = 2.0
	$CPUParticles2D.explosiveness = 0.0
	$CPUParticles2D.direction = Vector2(0, -1)
	$CPUParticles2D.spread = 20.0
	$CPUParticles2D.gravity = Vector2(0, -60)
	$CPUParticles2D.initial_velocity_min = 20.0
	$CPUParticles2D.initial_velocity_max = 60.0
	$CPUParticles2D.scale_amount_min = 2.0
	$CPUParticles2D.scale_amount_max = 7.0
	$CPUParticles2D.color = Color(0.75, 0.93, 1.0, 0.6)

	health_bar.max_value = max_health
	update_health_bar()

func update_health_bar() -> void:
	health_bar.value = health
	var health_ratio = health / max_health
	var fill = health_bar.get_theme_stylebox(\"fill\") as StyleBoxFlat
	if fill:
		fill.bg_color = Color(1.0 - health_ratio, health_ratio * 0.55, 0.0)

func take_damage(amount: float) -> void:
	health -= amount
	health = max(health, 0.0)
	update_health_bar()
	$Sprite2D.modulate = Color(1.0, 0.2, 0.2)
	await get_tree().create_timer(0.1).timeout
	$Sprite2D.modulate = Color(1.0, 1.0, 1.0)

func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed(\"repair\") and not repair_ui.visible and repair_cooldown_timer <= 0.0:
		open_repair()

func open_repair() -> void:
	repair_ui.show()
	repair_ui.start_minigame()
	Engine.time_scale = 0.25

func close_repair() -> void:
	repair_ui.hide()
	repair_cooldown_timer = repair_cooldown
	Engine.time_scale = 1.0

func apply_repair(percent: float) -> void:
	health = min(health + max_health * (percent / 100.0), max_health)
	update_health_bar()

func _physics_process(delta: float) -> void:
	pulse_time += delta * pulse_speed
	$PointLight2D.energy = 1.0 + sin(pulse_time) * 0.15

	if repair_cooldown_timer > 0.0:
		repair_cooldown_timer = max(repair_cooldown_timer - delta, 0.0)

	if repair_ui.visible:
		velocity = velocity.move_toward(Vector2.ZERO, friction * delta)
		move_and_slide()
		return

	# Health affects speed and boost
	var health_ratio = health / max_health
	var effective_max_speed = max_speed * (0.5 + 0.5 * health_ratio)
	var effective_boost_multiplier = 1.0 + (boost_speed_multiplier - 1.0) * health_ratio

	# Boost logic
	if boost_charge <= 0.0:
		boost_locked = true
	elif boost_charge >= 1.0:
		boost_locked = false

	is_boosting = Input.is_action_pressed(\"boost\") and boost_charge > 0.0 and not boost_locked

	if is_boosting:
		boost_charge -= boost_drain_rate * delta
		boost_charge = max(boost_charge, 0.0)
	else:
		boost_charge += boost_recharge_rate * delta
		boost_charge = min(boost_charge, 1.0)

	# Boost bar — blue when ready/boosting, red when drained/recharging
	boost_bar.max_value = 1.0
	boost_bar.value = boost_charge
	if is_boosting:
		boost_bar.modulate = Color(0.2, 0.8, 1.0)
	elif boost_charge < 1.0:
		boost_bar.modulate = Color(0.8, 0.3, 0.3)
	else:
		boost_bar.modulate = Color(0.2, 0.8, 1.0)

	# Movement
	var current_max_speed = effective_max_speed * (effective_boost_multiplier if is_boosting else 1.0)

	var direction = Vector2.ZERO
	if Input.is_action_pressed(\"Ascending\"):
		direction.y = -1
	elif Input.is_action_pressed(\"Descending\"):
		direction.y = 1
	if Input.is_action_pressed(\"Left\"):
		direction.x = -1
	elif Input.is_action_pressed(\"Right\"):
		direction.x = 1

	if direction != Vector2.ZERO:
		var target_angle = direction.angle() + PI
		rotation = lerp_angle(rotation, target_angle, turn_speed * delta)

		var r = fmod(rotation + PI * 2, PI * 2)
		if r > PI / 2 and r < PI * 1.5:
			$Sprite2D.flip_v = true
		else:
			$Sprite2D.flip_v = false

		velocity = velocity.move_toward(direction * current_max_speed, acceleration * delta)
	else:
		velocity = velocity.move_toward(Vector2.ZERO, friction * delta)

	move_and_slide()

	if get_slide_collision_count() > 0:
		damage_timer -= delta
		if damage_timer <= 0.0:
			take_damage(collision_damage)
			damage_timer = damage_cooldown
	else:
		damage_timer = 0.0

func show_warning():
	warning.start_flash()

func hide_warning():
	warning.stop_flash()
"

